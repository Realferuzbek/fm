{
  "name": "bespoke-date-invitation",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "invite:create": "node --conditions=react-server --import tsx scripts/create-invite.ts",
    "invite:revoke": "node --conditions=react-server --import tsx scripts/revoke-invite.ts",
    "data:purge": "node --conditions=react-server --import tsx scripts/purge-expired-data.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:screenshots": "playwright test --project=chromium --grep @visual",
    "notifications:retry": "node --conditions=react-server --import tsx scripts/retry-notifications.ts",
    "events:report": "node --conditions=react-server --import tsx scripts/report-events.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "^16.3.5",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.5",
    "jsdom": "^27.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.8"
  }
}
