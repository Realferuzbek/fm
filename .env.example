# Public origin used for same-origin request checks and generated invitation URLs.
# Do not include a trailing slash.
APP_ORIGIN=http://localhost:3000

# Neon/Postgres connection string. Keep this server-only; never expose it with a
# NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Telegram bot credentials. Create the bot with @BotFather and obtain the target
# chat ID before enabling private reservation notifications.
TELEGRAM_BOT_TOKEN=123456789:replace-with-a-real-server-side-bot-token
TELEGRAM_CHAT_ID=replace-with-the-private-chat-id

# Random server-only secrets. Generate distinct high-entropy values (for example,
# `openssl rand -hex 32`) for every environment.
INVITE_TOKEN_PEPPER=replace-with-a-64-hex-character-secret
INVITE_SESSION_SECRET=replace-with-a-64-hex-character-secret

# after: Vercel/Next keeps the invocation alive after the response (default).
# direct: await the bounded Telegram attempt after persistence, before responding.
TELEGRAM_DELIVERY_MODE=after
